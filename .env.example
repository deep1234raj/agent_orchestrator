# =============================================================================
# AAOP — environment configuration
#
# Copy this file to `.env` at the repo root and fill in the values.
# Docker Compose reads from `.env` automatically.
#
# Required for the demo:
#   - ANTHROPIC_API_KEY (the default LLM provider)
#   - TELEGRAM_BOT_TOKEN (so the bot can send/receive)
#   - TAVILY_API_KEY (web search tool used by the Researcher agent)
#
# Optional:
#   - OPENAI_API_KEY (alternative provider, per-agent configurable)
#   - TELEGRAM_WEBHOOK_SECRET (recommended for production; optional locally)
# =============================================================================

# --- Database ----------------------------------------------------------------
# These are read by both the Postgres container and the API.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aaop

# --- LLM providers -----------------------------------------------------------
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Get a key at https://platform.openai.com
OPENAI_API_KEY=

# --- Tools -------------------------------------------------------------------
# Tavily powers the `web_search` tool. Free tier is sufficient for the demo.
# https://tavily.com
TAVILY_API_KEY=

# --- Telegram channel --------------------------------------------------------
# Create a bot with @BotFather on Telegram and paste the token here.
TELEGRAM_BOT_TOKEN=

# Optional shared secret Telegram includes in the webhook header so the API
# can verify requests really came from Telegram. Generate any random string.
TELEGRAM_WEBHOOK_SECRET=

# --- App ---------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated list of origins the API will allow. Add ngrok or other
# tunnel URLs here when needed.
CORS_ORIGINS=http://localhost:3000

# --- Web ---------------------------------------------------------------------
# Exposed to the browser. Override if running the API on a different host.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
